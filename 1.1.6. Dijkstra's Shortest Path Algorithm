#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

// VIDUSHI TAYAL 25070521075

int findMin(int distance[], int visited[], int n)
{    int min = INFINITY;
    int index = -1;
    for (int i = 1; i <= n; i++) {
        if (!visited[i] && distance[i] < min) {
            min = distance[i];
            index = i;
        }
    }
return index;
}
void dijkstra(int G[MAX][MAX], int n, int startnode) {
	int distance[MAX];
    int visited[MAX];
    int parent[MAX];

    for (int i = 1; i <= n; i++) {
        distance[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
    }
    distance[startnode] = 0;
    for (int count = 1; count <= n - 1; count++) {
        int next = findMin(distance, visited, n);
        if (next == -1)
            break;
        visited[next] = 1;
        for (int i = 1; i <= n; i++) {
            if (!visited[i] &&
                G[next][i] != 0 &&
                distance[next] + G[next][i] < distance[i]) {
                distance[i] = distance[next] + G[next][i];
                parent[i] = next;
            }
        }
    }
	printf("Node\tDistance\tPath\n");
    for (int i = 1; i <= n; i++) {
        if (i == startnode)
            continue;
        printf("   %d\t     ", i);
        if (distance[i] == INFINITY) {
            printf("INF\tNO PATH\n");
        }
        else {
            printf("  %d\t", distance[i]);
            printf("%d", i);
            int j = i;
            while (parent[j] != -1) {
                printf("<-%d", parent[j]);
                j = parent[j];
            }
            printf("\n");
        }
    }
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
